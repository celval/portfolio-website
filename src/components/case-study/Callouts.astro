---
interface Item { icon?: string; text: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<div class="my-10 md:my-12 grid gap-3 sm:grid-cols-3">
  {items.map((item) => (
    <div class="rounded-lg bg-[#f4f4f2] p-5">
      {item.icon && <div class="text-2xl mb-3 leading-none">{item.icon}</div>}
      <p class="font-geist text-sm leading-[1.5] text-text">{item.text}</p>
    </div>
  ))}
</div>
