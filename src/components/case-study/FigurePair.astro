---
import { Image } from 'astro:assets';

interface Item { src: ImageMetadata; caption?: string; alt?: string; }
interface Props {
  items: Item[];
  /** Soft grey backing panel behind each image. Defaults on. */
  frame?: boolean;
}
const { items, frame = true } = Astro.props;
---

<!-- Two separate figures, each with its own frame and caption, with a gap between. -->
<div class="my-10 md:my-14 grid gap-4 md:gap-6 sm:grid-cols-2">
  {items.map((item) => (
    <figure>
      <div class={frame ? 'rounded-lg bg-[#f4f4f2] p-4 md:p-6' : ''}>
        <Image
          src={item.src}
          alt={item.alt ?? ''}
          widths={[320, 480, 720]}
          sizes="(max-width: 768px) 90vw, 340px"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-md"
        />
      </div>
      {item.caption && <figcaption class="mt-2 font-geist text-xs text-text">{item.caption}</figcaption>}
    </figure>
  ))}
</div>
