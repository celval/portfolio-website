---
import Layout from '../layouts/Layout.astro';
import HeaderClient from '../components/HeaderClient';
import Hero from '../components/Hero.astro';
import ProjectGridCard from '../components/ProjectGridCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const work = await getCollection('work', ({ data }) => !data.draft);
const caseStudySlugs = new Set(work.map((entry) => entry.id));
---

<Layout>
  <HeaderClient client:load />
  <main>
    <Hero />

    <!-- Selected Projects -->
    <section class="px-4 md:px-8 pt-24 pb-16 md:pb-24">
      <h2 class="font-editorial text-[24px] md:text-[28px] mb-14 md:mb-16">
        Selected Projects
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-12 md:gap-y-12">
        {projects.map((project) => (
          <ProjectGridCard project={project} hasCaseStudy={caseStudySlugs.has(project.slug)} />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
