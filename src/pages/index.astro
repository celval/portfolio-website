---
import Layout from '../layouts/Layout.astro';
import HeaderClient from '../components/HeaderClient';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const work = await getCollection('work', ({ data }) => !data.draft);
const caseStudySlugs = new Set(work.map((entry) => entry.id));
---

<Layout>
  <HeaderClient client:load />
  <main>
    <Hero />

    <!-- Selected Projects -->
    <section class="px-4 md:px-8 pt-24 pb-40 md:pb-56">
      <h2 class="font-editorial text-[24px] md:text-[28px] mb-20">
        Selected Projects
      </h2>
      {projects.map((project) => (
        <ProjectCard project={project} hasCaseStudy={caseStudySlugs.has(project.slug)} />
      ))}
    </section>
  </main>

  <Footer />
</Layout>
