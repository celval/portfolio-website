---
import Layout from '../layouts/Layout.astro';
import HeaderClient from '../components/HeaderClient';
import Hero from '../components/Hero.astro';
import ProjectGridCard from '../components/ProjectGridCard.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

import logoEnnismore from '../assets/images/logos/ennismore-wordmark.png';
import logoWimbledon from '../assets/images/logos/wimbledon-black.svg';
import logoDelli from '../assets/images/logos/delli.svg';
import logoMinorFigures from '../assets/images/logos/minor-figures.png';
import logoFarfetch from '../assets/images/logos/farfetch.png';
import logoBloomWild from '../assets/images/logos/bloom-wild.svg';
import logoAllergan from '../assets/images/logos/allergan-aesthetics.svg';
import logoGocardless from '../assets/images/logos/gocardless.png';
import logoGoshc from '../assets/images/logos/goshc.svg';

const clients = [
  { name: 'Ennismore', logo: logoEnnismore, maxH: 31 },
  { name: 'Wimbledon', logo: logoWimbledon, maxH: 52 },
  { name: 'Minor Figures', logo: logoMinorFigures, maxH: 24 },
  { name: 'Great Ormond Street', logo: logoGoshc, maxH: 52 },
  { name: 'Delli', logo: logoDelli, maxH: 21 },
  { name: 'Farfetch', logo: logoFarfetch, maxH: 14 },
  { name: 'Bloom & Wild', logo: logoBloomWild, maxH: 36 },
  { name: 'Allergan Aesthetics', logo: logoAllergan, maxH: 36 },
  { name: 'GoCardless', logo: logoGocardless, maxH: 18 },
];

const work = await getCollection('work', ({ data }) => !data.draft);
const caseStudySlugs = new Set(work.map((entry) => entry.id));
---

<Layout>
  <HeaderClient client:load />
  <main>
    <Hero />

    <!-- Selected Projects -->
    <section class="px-4 md:px-8 pt-24 pb-16 md:pb-24">
      <h2 class="font-editorial text-[24px] md:text-[28px] mb-14 md:mb-16">
        Selected Projects
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-12 md:gap-y-12">
        {projects.map((project) => (
          <ProjectGridCard project={project} hasCaseStudy={caseStudySlugs.has(project.slug)} />
        ))}
      </div>
    </section>

    <!-- Selected clients -->
    <section class="pb-24 md:pb-32">
      <h2 class="font-editorial text-[24px] md:text-[28px] mb-6 md:mb-8 px-4 md:px-8">
        Previously worked with
      </h2>
      <div class="logo-marquee relative overflow-hidden">
        <ul class="logo-track flex w-max">
          {Array.from({ length: 6 }, () => clients).flat().map((client, i) => (
            <li
              aria-hidden={i >= clients.length ? 'true' : undefined}
              class="flex aspect-[3/2] w-[172px] shrink-0 mr-3 md:mr-4 items-center justify-center rounded-md bg-[#f4f4f2]"
            >
              <img
                src={client.logo.src}
                alt={i >= clients.length ? '' : client.name}
                loading="lazy"
                decoding="async"
                class="object-contain w-auto max-w-[88%]"
                style={`max-height:${client.maxH}px`}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .logo-track {
    animation: logo-scroll 165s linear infinite;
  }
  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }
  @keyframes logo-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track { animation: none; }
  }
</style>
